@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(SharedCppLib2)

include("${CMAKE_CURRENT_LIST_DIR}/SCFTargets.cmake")

# scf_setup_executable(<target>)
# Applies the recommended configuration to a consumer executable target:
#   - C++20 (currently required by SharedCppLib2's typemask.hpp `requires`;
#     can drop to C++17 once that file is made C++17-compatible)
#   - Common-Controls v6 + PerMonitorV2 manifest (visual styles / DPI)
# Linking scf itself is still done by the caller with target_link_libraries.
function(scf_setup_executable target)
    if(NOT TARGET "${target}")
        message(FATAL_ERROR "scf_setup_executable: unknown target '${target}'")
    endif()
    set_target_properties(${target} PROPERTIES
        CXX_STANDARD 20
        CXX_STANDARD_REQUIRED ON
    )
    if(MSVC)
        # NOTE: CMAKE_CURRENT_LIST_DIR inside a function is the CALLER's
        # directory -- CMake functions are dynamically scoped, so it would
        # point at the consumer's project instead of this file's directory.
        # CMAKE_CURRENT_FUNCTION_LIST_DIR (3.17+) is the directory of the file
        # this function was DEFINED in, which is what we want here.
        set(_scf_manifest "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/scf_app.manifest")
        if(EXISTS "${_scf_manifest}")
            target_link_options(${target} PRIVATE "/MANIFESTINPUT:${_scf_manifest}")
        else()
            # Failing silently here costs the consumer their visual styles and
            # DPI awareness with no diagnostic at all, so say something.
            message(WARNING
                "scf_setup_executable: manifest not found at '${_scf_manifest}'; "
                "'${target}' will fall back to the classic (XP-era) control look.")
        endif()
    endif()
endfunction()

check_required_components(SCF)
